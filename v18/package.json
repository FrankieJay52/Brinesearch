{
  "name": "brinesearch-v18",
  "private": true,
  "version": "18.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "verify:fallback": "node scripts/sanitize-pad-fallback-data.mjs --check && node --test scripts/sanitize-pad-fallback-data.test.mjs",
    "verify:data-status": "node scripts/audit-v18-named-road-navigation-contract.mjs",
    "verify:ascent-batch2": "node scripts/audit-ascent-pad-approaches-batch2.mjs",
    "verify:eog-source": "node --test scripts/eog-pad-approach-source-contract.test.mjs",
    "verify:company-roads": "node scripts/audit-v18-public-company-road-overlay-contract.mjs",
    "verify:owner-roads": "node scripts/audit-v18-owner-approved-routes-map-issue108.mjs",
    "verify:owner-map": "node scripts/audit-v18-owner-google-verify-map.mjs",
    "verify:owner-google": "npm run verify:owner-map",
    "verify:ascent-corridors": "node --test scripts/audit-ascent-corridor-backtrace.test.mjs && node scripts/audit-ascent-corridor-backtrace.mjs",
    "verify:ascent-approach-generator": "node --test scripts/generate-ascent-pad-approaches-batch2.test.mjs",
    "verify:state1-promotion": "node scripts/audit-v18-driver-directory-status-contract.mjs && node scripts/audit-v18-cologie-public-google-release.mjs && node scripts/audit-v18-cologie-mobile-google-handoff.mjs && node scripts/audit-v18-una-west-grove-lease-endpoint.mjs && node scripts/audit-v18-stuart-tappan-scio-driver-name.mjs && npm run verify:ascent-corridors",
    "verify:batch0-audit": "node --test scripts/audit-batch0-ascent-navigation.test.mjs && node scripts/audit-batch0-ascent-navigation.mjs --check",
    "audit:batch0-navigation": "node scripts/audit-batch0-ascent-navigation.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "verify": "npm run verify:fallback && npm run verify:batch0-audit && npm run verify:data-status && npm run verify:ascent-approach-generator && npm run verify:ascent-batch2 && npm run verify:eog-source && npm run verify:company-roads && npm run verify:owner-roads && npm run verify:owner-map && npm run typecheck && npm run test",
    "build": "npm run verify && vite build --config vite.config.ts && node scripts/verify-built-runtime.mjs",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "maplibre-gl": "6.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "wa-sqlite": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "7.0.2",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
