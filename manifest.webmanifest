{
  "id": "/index.html",
  "name": "BrineSearch",
  "short_name": "BrineSearch",
  "description": "Mobile-first oilfield pad directory, directions, road updates, disposals, and field information.",
  "start_url": "/index.html#/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#08121f",
  "theme_color": "#08121f",
  "icons": [
    {
      "src": "./brand-kit/brinesearch-app-icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./brand-kit/brinesearch-app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
